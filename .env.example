# Tablet app (Vite — these are bundled into the client, so anon key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# There is deliberately no VITE_DEVICE_PASSWORD here any more.
#
# The tablet signs in as the shop device once, on the device, through the
# "Set up this tablet" screen. Supabase then keeps the session alive on its
# own. Setting these two brings back the old behaviour and the app will still
# honour them, but it will say so on every screen — a VITE_ value is compiled
# into the JavaScript, so shipping the password hands an authenticated session
# to anyone who views the page source, and that session can list the barbers'
# PIN hashes and insert sales that never happened into a table designed so
# nothing can ever be deleted.

# ---------------------------------------------------------------------------
# Edge function secrets. Set with `supabase secrets set KEY=value` — never
# committed and never bundled into the client.
# ---------------------------------------------------------------------------

# MTN MoMo (sandbox first; production needs registered business + KYC).
# Leave these empty while the shop is cash only. The momo-sync cron job is not
# scheduled until MoMo is live (migration 0007), and shop_settings.momo_enabled
# stays false so the nightly job skips Check A rather than running it against a
# feed that isn't there. See "Switching MoMo on later" in the README.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
# Optional: override if your approved MoMo product exposes statements elsewhere
# MOMO_STATEMENT_PATH=/collection/v1_0/account/statement

# Daily email report (Resend)
RESEND_API_KEY=
REPORT_FROM_EMAIL=reports@yourshop.example

# WhatsApp alerts on MEDIUM+ severity (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
