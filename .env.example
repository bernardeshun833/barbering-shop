# Tablet app (Vite — these are bundled into the client, so anon key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Credentials the tablet uses to sign in as the shop device. Provisioned once
# per tablet. Anyone with the built app has these — the anon key plus RLS is
# what limits what they can do, which is: insert transactions and cash counts,
# read the barber and service lists. Nothing else.
VITE_DEVICE_EMAIL=device@yourshop.example
VITE_DEVICE_PASSWORD=

# ---------------------------------------------------------------------------
# Edge function secrets. Set with `supabase secrets set KEY=value` — never
# committed and never bundled into the client.
# ---------------------------------------------------------------------------

# MTN MoMo (sandbox first; production needs registered business + KYC).
# Leave these empty while the shop is cash only: momo-sync skips cleanly when
# they are unset, and shop_settings.momo_enabled stays false so the nightly
# job skips Check A rather than running it against a feed that isn't there.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
# Optional: override if your approved MoMo product exposes statements elsewhere
# MOMO_STATEMENT_PATH=/collection/v1_0/account/statement

# Daily email report (Resend)
RESEND_API_KEY=
REPORT_FROM_EMAIL=reports@yourshop.example

# WhatsApp alerts on MEDIUM+ severity (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
