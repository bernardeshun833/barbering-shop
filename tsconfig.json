{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // The edge functions import the Supabase client from JSR, which only
      // Deno resolves. Pointing it at the npm package (same library, same
      // types) lets tsc check the functions too — see supabase/functions/deno.d.ts.
      "jsr:@supabase/supabase-js@2": ["node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["src", "tests", "vite.config.ts", "supabase/functions"]
}
